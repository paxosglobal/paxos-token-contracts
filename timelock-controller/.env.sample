# Network RPC URLs
URL_ETH_MAINNET="https://eth-mainnet.g.alchemy.com/v2/<api_key>"
URL_ETH_SEPOLIA="https://eth-sepolia.g.alchemy.com/v2/<api_key>"
URL_INK_MAINNET="https://ink-mainnet.g.alchemy.com/v2/<api_key>"
URL_INK_SEPOLIA="https://ink-sepolia.g.alchemy.com/v2/<api_key>"
URL_ARB_MAINNET="https://arb-mainnet.g.alchemy.com/v2/<api_key>"
URL_ARB_SEPOLIA="https://arb-sepolia.g.alchemy.com/v2/<api_key>"
URL_XLAYER_MAINNET="https://svc.blockdaemon.com/xlayer/mainnet/native?apiKey=<apikey>"
URL_XLAYER_TESTNET="https://svc.blockdaemon.com/xlayer/testnet/native?apiKey=<apikey>"
PRIVATE_KEY=""

# TimelockController deployment configuration
# Timelock delay in seconds (default: 86400 = 24 hours)
MIN_DELAY=86400
# Comma-separated list of proposer addresses
PROPOSERS=0x0000000000000000000000000000000000000000
# Comma-separated list of executor addresses
EXECUTORS=0x0000000000000000000000000000000000000000

# Contract verification API keys
ETHERSCAN_API_KEY=""
ARBISCAN_API_KEY=""
INKSCAN_API_KEY=""
EXPLORER_XLAYER_API_KEY=""
